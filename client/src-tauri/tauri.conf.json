{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "terminal-app",
  "version": "0.1.0",
  "identifier": "local.terminal-app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev:host && pnpm dev",
    "beforeBuildCommand": "pnpm build:host && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "terminal-app",
        "width": 1280,
        "height": 800,
        "minWidth": 488,
        "decorations": false,
        "backgroundColor": "#16141F"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:*",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:*",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/term-host"]
  }
}
